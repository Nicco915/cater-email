# Copy to .env in the repository root. Never commit the real .env.
# OS environment > .env > config/config.toml (mail settings).
# Values are literal: no shell expansion. Quote passwords containing spaces/#.
CATER_MAIL_ACCOUNT=your-mailbox@example.com
CATER_IMAP_HOST=imap.example.com
CATER_IMAP_PORT=993
CATER_IMAP_SSL=true
CATER_IMAP_STARTTLS=false
CATER_IMAP_PASSWORD="replace-with-mail-authorization-code"
CATER_SMTP_HOST=smtp.example.com
CATER_SMTP_PORT=465
CATER_SMTP_SSL=true
CATER_SMTP_STARTTLS=false
CATER_SMTP_PASSWORD="replace-with-mail-authorization-code"
CATER_FOLDER=INBOX
CATER_SENT_FOLDER=Sent
# Keep allowlists and sending switches in config.toml / local admin settings.
